# 也可在网页「推送与盯盘」面板保存到 data/settings.json
# 环境变量优先级高于本地文件

# Webhook（Server酱 / 钉钉 / 飞书 / 企微 / Discord 等）
PULSE_WEBHOOK_URL=
# auto | serverchan | dingtalk | feishu | wecom | discord | markdown | generic
PULSE_WEBHOOK_FORMAT=auto

# 定时推送（默认 Asia/Shanghai，每 15 分钟）
PULSE_PUSH_ENABLED=true
PULSE_PUSH_INTERVAL_MINUTES=15
# 可选：额外定点推送
PULSE_PUSH_TIMES=
PULSE_PUSH_TZ=Asia/Shanghai

# 盯盘关键词
PULSE_WATCH_KEYWORDS=FOMC,关税,降息

# 可选：保护 /api/push/test
PULSE_PUSH_SECRET=

# 可选：邮件推送
PULSE_SMTP_HOST=
PULSE_SMTP_PORT=587
PULSE_SMTP_USER=
PULSE_SMTP_PASSWORD=
PULSE_SMTP_TO=
PULSE_SMTP_FROM=
